# Constraints for SPI Test Module

# System Reset
ldc_set_location -site {43} [get_ports rst_n]

# BNO085 Sensor 1 (Right Hand)
ldc_set_location -site {20} [get_ports sclk1]
ldc_set_location -site {13} [get_ports mosi1]
ldc_set_location -site {12} [get_ports miso1]
ldc_set_location -site {18} [get_ports cs_n1]
ldc_set_location -site {9}  [get_ports int1]

# Status LEDs
ldc_set_location -site {28} [get_ports led_initialized]
ldc_set_location -site {38} [get_ports led_error]
ldc_set_location -site {41} [get_ports led_heartbeat] # RGB Blue (usually)
