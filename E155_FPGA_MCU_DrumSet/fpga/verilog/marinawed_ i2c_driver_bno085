module i2c_driver_bno085 (
    input  logic clk,
    input  logic rst_n,

    // System Bus interface TO the hard I2C block
    output logic        sb_stb,
    output logic        sb_wr,
    output logic [7:0]  sb_addr,
    output logic [7:0]  sb_wdata,
    input  logic [7:0]  sb_rdata,
    input  logic        sb_ack,

    // Output data
    output logic        imu_new_data,  // 1-clock pulse when imu_data has just been updated.
    output logic [7:0]  imu_data	   // latest byte read from IMU
);
		
		

    // -------------------------------------------------------------------------
    // HARD I2C REGISTER ADDRESSES (LEFT I2C)
    // SBADRI = {4'b0001, reg}
    // -------------------------------------------------------------------------
    localparam I2C_I2CCR1   = 8'h18;  // Control
    localparam I2C_I2CCMDR  = 8'h19;  // Command
    localparam I2C_I2CBRLSB = 8'h1A;  // Prescaler LSB
    localparam I2C_I2CBRMSB = 8'h1B;  // Prescaler MSB
    localparam I2C_I2CSR    = 8'h1C;  // Status
    localparam I2C_I2CTXDR  = 8'h1D;  // TX data
    localparam I2C_I2CRXDR  = 8'h1E;  // RX data

    // -------------------------------------------------------------------------
    // Command encodings (from Hardened I2C User Guide)
    // -------------------------------------------------------------------------
    localparam CMD_START_WRITE     = 8'h94; // START + WR + CKSDIS -> generate a start, send a write byte(the address), no ACK control needed: 
											// cmd_sttart_write: [STA=1, STO=0, RD=0, WR=1, ACK=0, CKSDIS=1, RBUFDIS=0]
    localparam CMD_WRITE           = 8'h14; // WR only
    localparam CMD_READ            = 8'h24; // RD (ACK=0)
    localparam CMD_READ_NACK_STOP  = 8'h6C; // RD + NACK + STOP
    localparam CMD_STOP            = 8'h44; // STOP only

    // -------------------------------------------------------------------------
    // BNO085 I2C address (DI pin LOW -> address = 0x4A)
    // -------------------------------------------------------------------------
    localparam [7:0] BNO_ADDR_READ = 8'h95;  // {0x4A,1'b1}

    // -------------------------------------------------------------------------
    // I2C prescale (example: 12 MHz -> 400 kHz)
    // PRESCALE = Fclk / (4 * Fi2c)
    //           12e6 / (4*400e3) = 7.5 ≈ 8
    // -------------------------------------------------------------------------
    localparam [9:0] PRESCALE = 10'd8;

    // -------------------------------------------------------------------------
    // Bus control signals
    // -------------------------------------------------------------------------
    logic bus_go;
    logic bus_read;
    logic bus_write;

    logic [7:0] bus_addr;
    logic [7:0] bus_data;

    // Forward to actual SB signals
    always_comb begin
        // default inactive
        sb_stb   = bus_go;
        sb_wr    = bus_write;
        sb_addr  = bus_addr;
        sb_wdata = bus_data;
    end

    // -------------------------------------------------------------------------
    // FSM STATES
    // -------------------------------------------------------------------------
    typedef enum logic [4:0] {
        S_RESET = 0,
        S_PRESCALE_LSB,
        S_PRESCALE_LSB_WAIT,
        S_PRESCALE_MSB,
        S_PRESCALE_MSB_WAIT,
        S_ENABLE,
        S_ENABLE_WAIT,
        S_IDLE,
        S_SEND_ADDR,
        S_SEND_ADDR_WAIT,
        S_ISSUE_READ,
        S_ISSUE_READ_WAIT,
        S_WAIT_RX_READY,
        S_READ_BYTE,
        S_DONE
    } state_t;

    state_t state, next;

    // store last read byte
    logic [7:0] rx_byte;

    // -------------------------------------------------------------------------
    // Sequential State
    // -------------------------------------------------------------------------
    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            state        <= S_RESET;
            imu_data     <= 8'd0;
            imu_new_data <= 1'b0;
        end else begin
            state        <= next;
        end
    end

    // -------------------------------------------------------------------------
    // FSM Logic
    // -------------------------------------------------------------------------
    always_comb begin
        // default: bus idle
        bus_go     = 1'b0;
        bus_write  = 1'b0;
        bus_read   = 1'b0;
        bus_addr   = 8'h00;
        bus_data   = 8'h00;

        imu_new_data = 1'b0;

        next = state;

        case (state)

        // --------------------------------------------------------------
        // Write PRESCALE LSB
        // --------------------------------------------------------------
        S_RESET: begin
            bus_go    = 1'b1;
            bus_write = 1'b1;
            bus_addr  = I2C_I2CBRLSB;
            bus_data  = PRESCALE[7:0];
            next      = S_PRESCALE_LSB_WAIT;
        end

        S_PRESCALE_LSB_WAIT: begin
            if (sb_ack) begin
                bus_go    = 1'b1;
                bus_write = 1'b1;
                bus_addr  = I2C_I2CBRMSB;
                bus_data  = {6'b0, PRESCALE[9:8]};
                next      = S_PRESCALE_MSB_WAIT;
            end
        end

        S_PRESCALE_MSB_WAIT: begin
            if (sb_ack) begin
                bus_go    = 1'b1;
                bus_write = 1'b1;
                bus_addr  = I2C_I2CCR1;
                bus_data  = 8'b1000_0000; // enable core
                next      = S_ENABLE_WAIT;
            end
        end

        S_ENABLE_WAIT: begin
            if (sb_ack)
                next = S_IDLE;
        end

        // --------------------------------------------------------------
        // Idle → start next read
        // --------------------------------------------------------------
        S_IDLE: begin
            // Write device address w/ read bit
            bus_go    = 1'b1;
            bus_write = 1'b1;
            bus_addr  = I2C_I2CTXDR;
            bus_data  = BNO_ADDR_READ;
            next      = S_SEND_ADDR_WAIT;
        end

        // --------------------------------------------------------------
        // Send START and address
        // --------------------------------------------------------------
        S_SEND_ADDR_WAIT: begin
            if (sb_ack) begin
                bus_go    = 1'b1;
                bus_write = 1'b1;
                bus_addr  = I2C_I2CCMDR;
                bus_data  = CMD_START_WRITE;
                next      = S_ISSUE_READ_WAIT;
            end
        end

        // --------------------------------------------------------------
        // Issue READ with NACK+STOP (single byte)
        // --------------------------------------------------------------
        S_ISSUE_READ_WAIT: begin
            if (sb_ack) begin
                // Poll TRRDY (status bit 2)
                bus_go   = 1'b1;
                bus_read = 1'b1;
                bus_addr = I2C_I2CSR;
                next     = S_WAIT_RX_READY;
            end
        end

        S_WAIT_RX_READY: begin
            bus_go   = 1'b1;
            bus_read = 1'b1;
            bus_addr = I2C_I2CSR;

            if (sb_ack) begin
                if (sb_rdata[2]) begin // TRRDY?
                    // Now issue READ+NACK+STOP
                    bus_go    = 1'b1;
                    bus_write = 1'b1;
                    bus_addr  = I2C_I2CCMDR;
                    bus_data  = CMD_READ_NACK_STOP;
                    next      = S_READ_BYTE;
                end
            end
        end

        // --------------------------------------------------------------
        // Read the incoming byte from RXDR
        // --------------------------------------------------------------
        S_READ_BYTE: begin
            bus_go   = 1'b1;
            bus_read = 1'b1;
            bus_addr = I2C_I2CRXDR;
            next     = S_DONE;
        end

        // --------------------------------------------------------------
        // Latch byte, notify user, and loop forever
        // --------------------------------------------------------------
        S_DONE: begin
            if (sb_ack) begin
                imu_data     = sb_rdata;
                imu_new_data = 1'b1;
                next         = S_IDLE;  // repeat forever
            end
        end

        default: next = S_RESET;
        endcase
    end

endmodule
