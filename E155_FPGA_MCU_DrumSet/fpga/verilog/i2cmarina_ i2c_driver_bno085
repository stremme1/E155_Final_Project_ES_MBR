module i2c_driver_bno085 (
    input  logic clk,
    input  logic rst_n,

    // System Bus interface TO the hard I2C block
    output logic        sb_stb,
    output logic        sb_wr,
    output logic [7:0]  sb_addr,
    output logic [7:0]  sb_wdata,
    input  logic [7:0]  sb_rdata,
    input  logic        sb_ack,

    // Output data
    output logic        imu_new_data,  
    output logic [7:0]  imu_data
);

    // -------------------------------------------------------------------------
    // HARD I2C REGISTER ADDRESSES
    // -------------------------------------------------------------------------
    localparam I2C_I2CCR1   = 8'h18;
    localparam I2C_I2CCMDR  = 8'h19;
    localparam I2C_I2CBRLSB = 8'h1A;  //00011010 -> clock prescale register, LSB
    localparam I2C_I2CBRMSB = 8'h1B;  //00011011 -> clock prescale register, MSB
    localparam I2C_I2CSR    = 8'h1C;
    localparam I2C_I2CTXDR  = 8'h1D;
    localparam I2C_I2CRXDR  = 8'h1E;

    // -------------------------------------------------------------------------
    // Command encodings
    // -------------------------------------------------------------------------
    localparam CMD_START_WRITE     = 8'h94;
    localparam CMD_WRITE           = 8'h14;
    localparam CMD_READ            = 8'h24;
    localparam CMD_READ_NACK_STOP  = 8'h6C;
    localparam CMD_STOP            = 8'h44;
	

    // -------------------------------------------------------------------------
    // BNO085 address (read)
    // -------------------------------------------------------------------------
    localparam [7:0] BNO_ADDR_READ = 8'h95;

    // Prescale for your frequency
    localparam [9:0] PRESCALE = 10'd15; // want 400kHz

    // -------------------------------------------------------------------------
    // FSM declarations
    // -------------------------------------------------------------------------
    typedef enum logic [4:0] {
        S_RESET = 0,
        S_PRESCALE_LSB,
        S_PRESCALE_LSB_WAIT,
		S_PRESCALE_MSB,
        S_PRESCALE_MSB_WAIT,
        S_ENABLE,
        S_ENABLE_WAIT,
        S_IDLE,
        S_SEND_ADDR,
        S_SEND_ADDR_WAIT,
        S_ISSUE_READ,
        S_ISSUE_READ_WAIT,
        S_WAIT_RX_READY,
        S_READ_BYTE,
        S_DONE
    } state_t;

    state_t state, next;

    // System bus controls
    logic        next_sb_stb, next_sb_wr;
    logic [7:0]  next_sb_addr, next_sb_wdata;

    // Data output registers
    logic        next_imu_new_data;
    logic [7:0]  next_imu_data;

    // -------------------------------------------------------------------------
    // Sequential logic
    // -------------------------------------------------------------------------
    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            state         <= S_RESET;
            sb_stb        <= 1'b0;
            sb_wr         <= 1'b0;
            sb_addr       <= 8'd0;
            sb_wdata      <= 8'd0;
            imu_data      <= 8'd0;
            imu_new_data  <= 1'b0;
        end else begin
            state         <= next;
            sb_stb        <= next_sb_stb;
            sb_wr         <= next_sb_wr;
            sb_addr       <= next_sb_addr;
            sb_wdata      <= next_sb_wdata;
            imu_data      <= next_imu_data;
            imu_new_data  <= next_imu_new_data;
        end
    end

    // -------------------------------------------------------------------------
    // Combinational next-state logic
    // -------------------------------------------------------------------------
    always_comb begin
        // Default outputs
        next_sb_stb       = 1'b0;
        next_sb_wr        = 1'b0;
        next_sb_addr      = 8'd0;
        next_sb_wdata     = 8'd0;

        next_imu_new_data = 1'b0;
        next_imu_data     = imu_data;

        next = state;

        case (state)

        //----------------------------------------------------------------------
        // Write PRESCALE LSB
        //----------------------------------------------------------------------
        S_RESET: begin
            next_sb_addr  = I2C_I2CBRLSB;
            next_sb_wdata = PRESCALE[7:0];	
            next_sb_stb   = 1'b1;
            next_sb_wr    = 1'b1;
            next          = S_PRESCALE_LSB_WAIT;
        end

        S_PRESCALE_LSB_WAIT: begin
			next_sb_stb   = 1'b0;
			next_sb_wr    = 1'b0;
            if (sb_ack) 
                next          = S_PRESCALE_MSB;
        end

        //----------------------------------------------------------------------
        // Write PRESCALE MSB
        //----------------------------------------------------------------------
        S_PRESCALE_MSB: begin
			next_sb_addr  = I2C_I2CBRMSB;
			next_sb_wdata = {6'b0, PRESCALE[9:8]};
			next_sb_stb   = 1'b1;
			next_sb_wr    = 1'b1;
			next          = S_PRESCALE_MSB_WAIT;
        end

        S_PRESCALE_MSB_WAIT: begin
			next_sb_stb   = 1'b0;
			next_sb_wr    = 1'b0;
            if (sb_ack)
                next          = S_ENABLE;
        end
		
        //----------------------------------------------------------------------
        // Enable I2C core
        //----------------------------------------------------------------------
		S_ENABLE: begin       
			next_sb_stb   = 1'b1;
			next_sb_wr    = 1'b1;
			next_sb_addr  = I2C_I2CCR1;
			next_sb_wdata = 8'b10000000; //enable (i2cen bit enables the i2c core functions)
			next          = S_ENABLE_WAIT;
        end
		
        S_ENABLE_WAIT: begin
			next_sb_stb   = 1'b0;
			next_sb_wr    = 1'b0;
            if (sb_ack)begin
                next = S_IDLE;
			end
        end
		
		
        //----------------------------------------------------------------------
        // Send slave address (TXDR)
        //----------------------------------------------------------------------
        S_IDLE: begin
            next_sb_stb   = 1'b1;
            next_sb_wr    = 1'b1;
            next_sb_addr  = I2C_I2CTXDR;
            next_sb_wdata = BNO_ADDR_READ;
            next          = S_SEND_ADDR_WAIT;
        end

        S_SEND_ADDR_WAIT: begin
            if (sb_ack) begin
                next_sb_stb   = 1'b1;
                next_sb_wr    = 1'b1;
                next_sb_addr  = I2C_I2CCMDR;
                next_sb_wdata = CMD_START_WRITE;
                next          = S_ISSUE_READ_WAIT;
            end
        end

        //----------------------------------------------------------------------
        // Poll status register until ready
        //----------------------------------------------------------------------
        S_ISSUE_READ_WAIT: begin
            if (sb_ack) begin
                next_sb_stb  = 1'b1;
                next_sb_addr = I2C_I2CSR;
                next          = S_WAIT_RX_READY;
            end
        end

        S_WAIT_RX_READY: begin
            next_sb_stb  = 1'b1;
            next_sb_addr = I2C_I2CSR;

            if (sb_ack && sb_rdata[2]) begin
                next_sb_stb   = 1'b1;
                next_sb_wr    = 1'b1;
                next_sb_addr  = I2C_I2CCMDR;
                next_sb_wdata = CMD_READ_NACK_STOP;
                next          = S_READ_BYTE;
            end
        end

        //----------------------------------------------------------------------
        // Read from RXDR
        //----------------------------------------------------------------------
        S_READ_BYTE: begin
            next_sb_stb  = 1'b1;
            next_sb_addr = I2C_I2CRXDR;
            next         = S_DONE;
        end

        //----------------------------------------------------------------------
        // Latch result & loop
        //----------------------------------------------------------------------
        S_DONE: begin
            if (sb_ack) begin
                next_imu_data     = sb_rdata;
                next_imu_new_data = 1'b1;
                next              = S_IDLE;
            end
        end

        endcase
    end

endmodule
